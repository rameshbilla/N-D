# =====================================================================
# N&D Nature Healthy Food — environment variables
# Copy to .env for development (loaded by src/server.ts). NEVER commit real values.
# All of these are read only by the Node/Express server — none are sent to the browser.
# =====================================================================

# Public site URL (sitemap, canonical links, email links, allowed host for SSR)
SITE_URL=http://localhost:4200

# ---------- Supabase (Project Settings → API) ----------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Bypasses RLS — used for order creation, payments, rate limiting, uploads.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# ---------- Admin ----------
# Initial Super Admin phone (E.164). It is also seeded in supabase/seed.sql.
# On first admin login the app ensures this number is on the allowlist as super_admin.
INITIAL_SUPER_ADMIN_PHONE=+919014325025

# ---------- OTP abuse protection (app-level, on top of Supabase Auth limits) ----------
# OTP length (6) and expiry are configured in Supabase: Auth → Providers → Phone.
OTP_RESEND_COOLDOWN_SECONDS=45
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_SENDS_PER_IP_PER_HOUR=20
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_VERIFY_WINDOW_MINUTES=15

# ---------- Razorpay (Dashboard → Account & Settings → API Keys) ----------
# Leave empty to disable online payments (checkout will offer COD only if enabled in settings).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks. Point to https://YOUR-DOMAIN/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# ---------- Email notifications (Resend — https://resend.com) ----------
RESEND_API_KEY=
EMAIL_FROM="N&D Nature Healthy Food <orders@your-domain.in>"
# Where new-order / new-request alerts are sent
ADMIN_NOTIFICATION_EMAIL=

# ---------- Optional WhatsApp notifications (Meta WhatsApp Cloud API) ----------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template name with one body parameter ({{1}} = message text)
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
